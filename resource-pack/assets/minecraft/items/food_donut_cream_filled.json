{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:custom_name",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_name",
      "cases": [
        {
          "when": "Cream Filled Donut Dish",
          "model": {
            "type": "minecraft:model",
            "model": "item/foods/donut_cream_filled_dish"
          }
        },
        {
          "when": "Dona con crema Plato",
          "model": {
            "type": "minecraft:model",
            "model": "item/foods/donut_cream_filled_dish"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/food_donut_cream_filled"
      }
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "minecraft:item/food_donut_cream_filled"
    }
  }
}