{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:item_name",
    "cases": [
      {
        "when": {
          "translate": "item.dnt.boss_sealing_key",
          "fallback": "Boss Sealing Key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "dnt:item/keys/boss_sealing_key"
        }
      },
      {
        "when": {
          "translate": "item.dnt.citadel_boss_key",
          "fallback": "Citadel Boss Key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "dnt:item/keys/citadel_boss_key"
        }
      },
      {
        "when": {
          "translate": "item.dnt.end_ship_key",
          "fallback": "End Ship Key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "dnt:item/keys/end_ship_key"
        }
      },
      {
        "when": {
          "translate": "item.dnt.ominous_sealing_key",
          "fallback": "Ominous Sealing Key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "dnt:item/keys/ominous_sealing_key"
        }
      },
      {
        "when": {
          "translate": "item.dnt.ominous_shrine_key",
          "fallback": "Ominous Shrine Key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "dnt:item/keys/ominous_shrine_key"
        }
      },
      {
        "when": {
          "translate": "item.dnt.ominous_toxic_key",
          "fallback": "Ominous Toxic Key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "dnt:item/keys/ominous_toxic_key"
        }
      },
      {
        "when": {
          "translate": "item.dnt.toxic_boss_key",
          "fallback": "Toxic Boss Key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "dnt:item/keys/toxic_boss_key"
        }
      },
      {
        "when": {
          "translate": "item.dnt.trident_trial_boss_key",
          "fallback": "Trident Trial Boss Key"
        },
        "model": {
          "type": "minecraft:model",
          "model": "dnt:item/keys/monument_boss_key"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/ominous_trial_key"
    }
  }
}