{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:written_book_content",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "firstperson_righthand",
            "firstperson_lefthand",
            "thirdperson_righthand",
            "thirdperson_lefthand",
            "gui",
            "ground",
            "on_shelf"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "moldomre:item/written_book_iron"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": [
              "head",
              "fixed"
            ],
            "model": {
              "type": "minecraft:model",
              "model": "moldomre:item/books/book_iron"
            }
          }
        ]
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "firstperson_righthand",
            "firstperson_lefthand",
            "thirdperson_righthand",
            "thirdperson_lefthand",
            "gui",
            "ground",
            "on_shelf"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "moldomre:item/writable_book_iron"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          {
            "when": [
              "head",
              "fixed"
            ],
            "model": {
              "type": "minecraft:model",
              "model": "moldomre:item/books/book_iron"
            }
          }
        ]
      }
    }
  }
}