{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:custom_name",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_name",
      "cases": [
        {
          "when": "Smoked Steak Dish",
          "model": {
            "type": "minecraft:model",
            "model": "moldomre:item/foods/smoked_beef_dish"
          }
        },
        {
          "when": "Bistec ahumado Plato",
          "model": {
            "type": "minecraft:model",
            "model": "moldomre:item/foods/smoked_beef_dish"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "moldomre:item/food_smoked_beef"
      }
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "moldomre:item/food_smoked_beef"
    }
  }
}